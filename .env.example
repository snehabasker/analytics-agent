# ANTHROPIC_API_KEY=sk-ant-...        # unset -> offline heuristic planner
# ANALYTICS_LLM=auto                  # auto | claude | heuristic
# ANALYTICS_MODEL=claude-sonnet-5-5   # planner
# ANALYTICS_NARRATE_MODEL=claude-haiku-5-5
# QDRANT_URL=http://localhost:6333    # unset -> in-process Qdrant
# TRACE_FILE=traces/traces.jsonl
# ANALYTICS_EMBEDDER=hashing          # hashing | cohere   (cohere: pip install -e .[cohere])
# ANALYTICS_RERANKER=none             # none | cohere
# COHERE_API_KEY=...
# COHERE_EMBED_MODEL=embed-v4.0
# COHERE_RERANK_MODEL=rerank-v3.5
